                    "jmp syscall_32to64_return\n" )
 
 
+/* lcall into the next bytes as 64-bit code, drop what the lcall pushed, jump to the 64-bit entry point. */
+static void init_rosetta_thunk( struct thunk_32to64_rosetta *thunk, void *entry )
+{
+    thunk->lcall     = 0xff;
+    thunk->modrm     = 0x1d;
+    thunk->op        = PtrToUlong( &thunk->addr );
+    thunk->addr      = PtrToUlong( &thunk->add );
+    thunk->cs        = cs64_sel;
+    thunk->add       = 0x83;
+    thunk->add_modrm = 0xc4;
+    thunk->add_op    = 0x08;
+    thunk->jmp       = 0xff;
+    thunk->jmp_modrm = 0x25;
+    thunk->jmp_op    = 0;
+    thunk->jmp_addr  = (ULONG_PTR)entry;
+}
+
