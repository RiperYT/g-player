+/* Rosetta 2 workaround (after CodeWeavers' CW HACK 20760): a far call into 64-bit code, which then drops the
+ * return address the call pushed and jumps on. Under Rosetta 2 a far jump between 32- and 64-bit code sometimes
+ * doesn't switch modes. */
+struct thunk_32to64_rosetta
+{
+    BYTE  lcall;      /* call far, absolute indirect */
+    BYTE  modrm;      /* address=disp32, opcode=3 */
+    DWORD op;
+    DWORD addr;
+    WORD  cs;
+    BYTE  add;        /* add $0x08,%esp */
+    BYTE  add_modrm;
+    BYTE  add_op;
+    BYTE  jmp;        /* jmp *0(%rip) */
+    BYTE  jmp_modrm;
+    DWORD jmp_op;
+    ULONG64 jmp_addr;
+};
 struct thunk_opcodes
 {
-    struct thunk_32to64 syscall_thunk;
-    struct thunk_32to64 unix_thunk;
+    union
+    {
+        struct thunk_32to64 syscall_thunk;
+        struct thunk_32to64_rosetta syscall_thunk_rosetta;
+    };
+    union
+    {
+        struct thunk_32to64 unix_thunk;
+        struct thunk_32to64_rosetta unix_thunk_rosetta;
+    };
 };
 #pragma pack(pop)
 
@@ -57,6 +84,17 @@
 
 void **__wine_unix_call_dispatcher = NULL;
 
+/* True when running under Rosetta 2, which reports itself as a "VirtualApple" processor. */
+BOOL use_rosetta_workaround = FALSE;
+
+static BOOL is_rosetta(void)
+{
+    char DECLSPEC_ALIGN(4) buffer[64];   /* the call fails on a misaligned buffer */
+    if (NtQuerySystemInformation( SystemProcessorBrandString, buffer, sizeof(buffer), NULL )) return FALSE;
+    buffer[sizeof(buffer) - 1] = 0;
+    return strstr( buffer, "VirtualApple" ) != NULL;
+}
+
 BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
 {
     if (reason == DLL_PROCESS_ATTACH) LdrDisableThreadCalloutsForDll( inst );
