+/* Scales the samples by the program's volume, as winealsa does: the volume a program sets for its stream or
+ * session must not change the device's volume, which is the Mac's own setting. */
+static void adjust_buffer_volume(struct coreaudio_stream *stream, BYTE *buf, UINT32 frames)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)stream->fmt;
+    UINT32 i, channels = stream->fmt->nChannels, mute = 0;
+    BOOL adjust = FALSE, is_float, is_pcm;
+    BYTE *end = buf + frames * stream->fmt->nBlockAlign;
+
+    if (!frames || !stream->vols) return;
+    for (i = 0; i < channels; i++)
+    {
+        adjust |= stream->vols[i] != 1.0f;
+        if (stream->vols[i] == 0.0f) mute++;
+    }
+    if (mute == channels)
+    {
+        silence_buffer(stream, buf, frames);
+        return;
+    }
+    if (!adjust) return;
+
+    is_float = stream->fmt->wFormatTag == WAVE_FORMAT_IEEE_FLOAT ||
+               (stream->fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+                IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT));
+    is_pcm = stream->fmt->wFormatTag == WAVE_FORMAT_PCM ||
+             (stream->fmt->wFormatTag == WAVE_FORMAT_EXTENSIBLE &&
+              IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_PCM));
+
+#define PROCESS_BUFFER(type) do         \
+{                                       \
+    type *p = (type *)buf;              \
+    while ((BYTE *)p < end)             \
+    {                                   \
+        for (i = 0; i < channels; i++)  \
+            p[i] = p[i] * stream->vols[i]; \
+        p += channels;                  \
+    }                                   \
+} while (0)
+    if (is_float && stream->fmt->wBitsPerSample == 32) PROCESS_BUFFER(float);
+    else if (is_float && stream->fmt->wBitsPerSample == 64) PROCESS_BUFFER(double);
+    else if (is_pcm && stream->fmt->wBitsPerSample == 16) PROCESS_BUFFER(INT16);
+#undef PROCESS_BUFFER
+    else if (is_pcm && stream->fmt->wBitsPerSample == 32)
+    {
+        /* A float can't hold every 32-bit sample, and a peak rounded up past INT32_MAX would wrap around: work in
+         * double and clamp. */
+        INT32 *p = (INT32 *)buf;
+        while ((BYTE *)p < end)
+        {
+            for (i = 0; i < channels; i++)
+            {
+                double v = p[i] * (double)stream->vols[i];
+                p[i] = v >= 2147483647.0 ? 2147483647 : v <= -2147483648.0 ? (INT32)0x80000000 : (INT32)v;
+            }
+            p += channels;
+        }
+    }
+    else if (is_pcm && stream->fmt->wBitsPerSample == 24)
+    {
+        BYTE *p = buf;
+        i = 0;
+        while (p < end)
+        {
+            INT32 v = (INT32)((UINT32)p[0] << 8 | (UINT32)p[1] << 16 | (UINT32)p[2] << 24);
+            v = (INT32)(v * stream->vols[i]);
+            p[0] = v >> 8; p[1] = v >> 16; p[2] = v >> 24;
+            p += 3;
+            if (++i == channels) i = 0;
+        }
+    }
+    else if (is_pcm && stream->fmt->wBitsPerSample == 8)
+    {
+        UINT8 *p = buf;
+        while ((BYTE *)p < end)
+        {
+            for (i = 0; i < channels; i++)
+                p[i] = (int)((p[i] - 128) * stream->vols[i]) + 128;
+            p += channels;
+        }
+    }
+    /* Other formats are left as they are; mmdevapi doesn't let them through. No logging here: this runs on
+     * CoreAudio's own thread, which isn't a Wine thread. */
 }
 
