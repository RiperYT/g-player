			<key>other</key>
			<string>%lld параметра реєстру</string>
		</dict>
	</dict>
	<key>G-Player stopped everything in it to keep your Mac usable. A long folder path is the usual cause. Keep a space's path under %lld characters.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>G-Player зупинив усе в цьому просторі, щоб Mac працював далі. Зазвичай причина — задовгий шлях до папки. Шлях до простору має бути коротшим за %#@count@.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld символи</string>
			<key>many</key>
			<string>%lld символів</string>
			<key>one</key>
			<string>%lld символ</string>
			<key>other</key>
			<string>%lld символу</string>
		</dict>
	</dict>
	<key>It quit after %lld seconds without saying why.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Гра закрилася через %#@count@, нічого не пояснивши.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld секунди</string>
			<key>many</key>
			<string>%lld секунд</string>
			<key>one</key>
			<string>%lld секунду</string>
			<key>other</key>
			<string>%lld секунди</string>
		</dict>
	</dict>
	<key>It took longer than %lld minutes, so G-Player stopped it.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Процес тривав понад %#@count@, тож G-Player його зупинив.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>few</key>
			<string>%lld хвилини</string>
