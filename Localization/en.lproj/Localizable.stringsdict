<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- English plural forms. A key with a count whose words change with it (1 game, 2 games) is here, and so it needs
     one/few/many/other in uk.lproj/Localizable.stringsdict. scripts/l10n.sh reads this file for the list. -->
<plist version="1.0">
<dict>
	<key>%lld Windows programs were running</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Windows program was running</string>
			<key>other</key>
			<string>%lld Windows programs were running</string>
		</dict>
	</dict>
	<key>%lld Windows programs were running, %lld of them Windows Explorer</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@, %lld of them Windows Explorer</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Windows program was running</string>
			<key>other</key>
			<string>%lld Windows programs were running</string>
		</dict>
	</dict>
	<key>%lld environment settings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld environment setting</string>
			<key>other</key>
			<string>%lld environment settings</string>
		</dict>
	</dict>
	<key>%lld hidden games in this space</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld hidden game in this space</string>
			<key>other</key>
			<string>%lld hidden games in this space</string>
		</dict>
	</dict>
	<key>%lld registry settings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld registry setting</string>
			<key>other</key>
			<string>%lld registry settings</string>
		</dict>
	</dict>
	<key>G-Player stopped everything in it to keep your Mac usable. A long folder path is the usual cause. Keep a space's path under %lld characters.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>G-Player stopped everything in it to keep your Mac usable. A long folder path is the usual cause. Keep a space's path under %#@count@.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld character</string>
			<key>other</key>
			<string>%lld characters</string>
		</dict>
	</dict>
	<key>It quit after %lld seconds without saying why.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>It quit after %#@count@ without saying why.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld second</string>
			<key>other</key>
			<string>%lld seconds</string>
		</dict>
	</dict>
	<key>It took longer than %lld minutes, so G-Player stopped it.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>It took longer than %#@count@, so G-Player stopped it.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minute</string>
			<key>other</key>
			<string>%lld minutes</string>
		</dict>
	</dict>
	<key>It took longer than %lld seconds, so G-Player stopped it.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>It took longer than %#@count@, so G-Player stopped it.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld second</string>
			<key>other</key>
			<string>%lld seconds</string>
		</dict>
	</dict>
	<key>Its path is %lld characters long; the limit is %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Its path is %#@count@ long; the limit is %lld.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld character</string>
			<key>other</key>
			<string>%lld characters</string>
		</dict>
	</dict>
	<key>New spaces can't be made in this library: its folder's path is %lld characters long and the limit is %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>New spaces can't be made in this library: its folder's path is %#@count@ long and the limit is %lld.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld character</string>
			<key>other</key>
			<string>%lld characters</string>
		</dict>
	</dict>
	<key>The Rosetta 2 install took longer than %lld minutes, so G-Player stopped waiting. Choose Install to try again.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>The Rosetta 2 install took longer than %#@count@, so G-Player stopped waiting. Choose Install to try again.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minute</string>
			<key>other</key>
			<string>%lld minutes</string>
		</dict>
	</dict>
	<key>The library folder's path is %lld characters long; the limit is %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>The library folder's path is %#@count@ long; the limit is %lld.</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld character</string>
			<key>other</key>
			<string>%lld characters</string>
		</dict>
	</dict>
	<key>Use %lld known fixes for this game</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Use %lld known fix for this game</string>
			<key>other</key>
			<string>Use %lld known fixes for this game</string>
		</dict>
	</dict>
</dict>
</plist>
